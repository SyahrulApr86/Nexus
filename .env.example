# Copy to .env and fill in.
# Database passwords go inside a postgres:// URL, so they must be URL-safe: generate them with
#   openssl rand -hex 32
# (base64 output contains "/" and "+", which break the URL unless percent-encoded).
POSTGRES_PASSWORD=
# Password of nexus_app, the least-privilege role the production app connects as (docker-compose.yml).
APP_DB_PASSWORD=
DB_PORT=5442
DATABASE_URL=postgres://nexus:<POSTGRES_PASSWORD>@127.0.0.1:5442/nexus
# Session signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Production MUST use https:// (cookies are only Secure on https);
# the app refuses to start in production with an http:// URL other than localhost.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Self-registration. Leave false; set true only to create the owner account, then set it back
# and restart.
NEXUS_ALLOW_SIGNUP=false
# Only when X-Forwarded-For passes through more than one proxy: their IPs/CIDRs, comma-separated.
# NEXUS_TRUSTED_PROXIES=
# Where attachment files are stored (src/lib/attachments/storage.ts). Default ./data in development;
# the Docker image uses /data (volume appdata in docker-compose.yml). Back it up with the database.
# NEXUS_DATA_DIR=./data
# Live collaboration service (collab/README.md). Empty: the editor uses wss://<this origin>/collab behind
# the reverse proxy, and falls back to REST autosave when nothing answers there. In development run
# `pnpm collab:dev` and set ws://localhost:3001 (same host as the app, so the session cookie is sent).
# A separate origin is added to the CSP connect-src; production accepts wss:// only.
NEXT_PUBLIC_COLLAB_URL=
# COLLAB_PORT=3001
