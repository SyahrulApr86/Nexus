# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright end-to-end runs (tests/e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# attachment storage in development (NEXUS_DATA_DIR defaults to ./data)
/data/

# local browser-test artifacts
.playwright-mcp/

# design-taste working output (screenshots, inspector runs); the dealt direction sheets are kept
.taste-skill/*/inspect/
.taste-skill/inspect/
.taste-skill/before/
.taste-skill/after/

# design-taste-frontend working files
/.taste-skill/
